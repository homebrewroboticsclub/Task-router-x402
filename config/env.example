# 0.0.0.0 — listen on all interfaces (reachable by server IP). 127.0.0.1 — this machine only.
HOST=0.0.0.0
PORT=3000

# PostgreSQL (teleoperator accounts + persisted robot registry table `robots`). If unset, /api/teleoperator and /teleoperator UI are disabled; robots are in-memory only.
# Local dev (host Postgres, shared instance, own DB): scripts/dev-local-up.sh — use port 5432 and database x402raid.
# Legacy Docker compose host port was often 5436; adjust if your compose maps a different port.
DATABASE_URL=postgres://x402:x402@127.0.0.1:5432/x402raid
# Integration tests only (npm test). Do NOT set on a server using the same Postgres as compose:
# if TEST_DATABASE_URL points at the same URI as forwarded compose Postgres, tests run TRUNCATE — robots, operators, grants are wiped.
# TEST_DATABASE_URL=postgres://x402:x402@127.0.0.1:5432/x402raid
# JWT for teleoperator session cookie (required when DATABASE_URL is set). In production set a long random secret.
TELEOPERATOR_JWT_SECRET=change-this-teleoperator-jwt-secret
# Optional: e.g. 7d, 24h, 3600s
TELEOPERATOR_JWT_EXPIRES_IN=7d
# Optional bcrypt cost (default 10)
# TELEOPERATOR_BCRYPT_ROUNDS=10
# Secure flag on teleoperator cookie: auto (default), always, never.
# Previously with NODE_ENV=production Secure was always true — browser dropped cookie on plain HTTP (login appeared to do nothing).
# TELEOPERATOR_COOKIE_SECURE=auto
# Behind reverse proxy (nginx) with HTTPS: trust X-Forwarded-Proto; value is hop count (often 1)
# TRUST_PROXY=1

X402_PRIVATE_KEY=replace-with-private-key
X402_WALLET_ID=wallet-identifier
X402_GATEWAY_URL=https://api.corbits.dev
X402_PAYMENT_ENDPOINT=/v1/payments
X402_PAYMENT_TIMEOUT_MS=10000
X402_PAYMENT_PROVIDER=gateway
X402_CONFIRM_ATTEMPTS=5
X402_CONFIRM_DELAY_MS=2000
# Solana RPC: helius (recommended), public, or custom
SOLANA_RPC_PROVIDER=helius
HELIUS_API_KEY=your-helius-api-key
# Fallback RPC (not mainnet-beta — often 403). Configure Helius in admin UI or HELIUS_API_KEY
X402_SOLANA_RPC_URL=https://solana-rpc.publicnode.com
X402_SOLANA_COMMITMENT=confirmed
X402_SOLANA_MIN_CONFIRMATIONS=1
# Base64 or JSON secret key; defaults to X402_PRIVATE_KEY when omitted
X402_SOLANA_SECRET_KEY=

COMMAND_DANCE_STRATEGY=lowest_price
COMMAND_BUY_COLA_STRATEGY=closest

PRICING_MARKUP_PERCENT=10

ROBOT_HEALTH_TIMEOUT_MS=5000
ROBOT_COMMAND_TIMEOUT_MS=8000
ROBOT_HEALTH_ENDPOINT=/health
ROBOT_SECURE_HEALTH_ENDPOINT=/helth

# Robot → RAID (enroll): Bearer or X-Robot-Fleet-Secret on POST /api/robots/enroll and (with admin) mutating /api/robots.
# Same string on each robot that self-registers. Not the same as RAID_TO_ROBOT_SECRET.
# ROBOT_FLEET_ENROLLMENT_SECRET=

# RAID → robot (allowlist / dataNodeSync push): header X-Raid-To-Robot-Secret on POST to each robot's operatorRegistryUrl.
# Robots verify this header; it is never sent on enroll. See docs/ROBOT_OPERATOR_SYNC.md.
# RAID_TO_ROBOT_SECRET=

# DATA_NODE batch provisioning pushed to robots (enroll + sync-operator-allowlist). See docs/ROBOT_OPERATOR_SYNC.md.
# You may also set fleet URL/token in Admin UI → Services registration (writes gitignored config/services-registration.json).
# If DATA_NODE_SYNC_BASE_URL is set, fleet provisioning is enabled unless DATA_NODE_SYNC_PROVISION_ENABLED=false.
# DATA_NODE_SYNC_PROVISION_ENABLED=
# DATA_NODE_SYNC_BASE_URL=https://data-node.example
# DATA_NODE_SYNC_BATCH_PATH=/v1/ingest/robot-events
# DATA_NODE_SYNC_ENABLED=false
# DATA_NODE_SYNC_INTERVAL_SEC=300
# DATA_NODE_SYNC_AUTH_HEADER_NAME=Authorization
# DATA_NODE_SYNC_AUTH_HEADER_VALUE=Bearer your-ingest-token
# DATA_NODE_SYNC_INCLUDE_DASHBOARD=true
# DATA_NODE_SYNC_INCLUDE_AUDIT=true
# DATA_NODE_SYNC_INCLUDE_STATE_USB=true
# DATA_NODE_SYNC_INCLUDE_KYR_INCIDENTS=true

# Optional: POST JSON to DATA_NODE when a new teleop help request is created (off by default). See README.
# DATA_NODE_INCIDENT_RELAY_ENABLED=true
# DATA_NODE_INCIDENT_RELAY_URL=https://data-node.example/v1/ingest/raid-help
# DATA_NODE_INCIDENT_RELAY_METHOD=POST
# DATA_NODE_INCIDENT_RELAY_AUTH_HEADER=Authorization
# DATA_NODE_INCIDENT_RELAY_AUTH_VALUE=Bearer …

# mDNS: advertise HTTP on LAN as <MDNS_HOSTNAME>.local (UDP 5353; Docker often needs host network).
# MDNS_ENABLED=true
# MDNS_HOSTNAME=raid-app
# Optional: set to task-router-x402 (or any label) for a new mDNS name; default stays raid-app for robot/LAN compatibility.

# Teleop: WebSocket proxy to ROSBridge (same HTTP port as app). Disabled if TELEOP_WS_ENABLED=false or 0.
# TELEOP_WS_ENABLED=true
# Max incoming/outgoing WS frame payload (bytes)
# TELEOP_MAX_MESSAGE_BYTES=16777216
# Timeout per attempt to open ws://rosbridgeHost:rosbridgePort from server to robot (LAN)
# TELEOP_ROSBRIDGE_CONNECT_TIMEOUT_MS=10000
# Attempts per connect wave + delay between attempts (initial connect and each reconnect wave)
# TELEOP_ROSBRIDGE_CONNECT_ATTEMPTS=3
# TELEOP_ROSBRIDGE_RECONNECT_DELAY_MS=2000
# After rosbridge was up then dropped: how many full connect waves to try while client WS still open
# TELEOP_ROSBRIDGE_DROP_RECONNECT_ATTEMPTS=3
# Delay closing teleop_sessions row after client disconnect or final rosbridge failure (ms); 0 = immediate
# TELEOP_SESSION_END_GRACE_MS=120000
# Outbound WS to rosbridge: forward teleoperator id (JWT sub) and login to the robot.
# Headers X-Teleoperator-Id, X-Teleoperator-Login and query teleoperator_id, teleoperator_login.
# Disable if proxy/rosbridge breaks on query or non-standard headers (false / 0).
# TELEOP_FORWARD_OPERATOR_HEADERS=true
# TELEOP_FORWARD_OPERATOR_QUERY=true
# HTTP reverse proxy /api/teleop/robots/:id/dataset/* → robot dataset server (connect + body timeout, ms)
# TELEOP_DATASET_PROXY_TIMEOUT_MS=300000

# KYR SessionGrant (Ed25519): Solana-format secret (same as X402_SOLANA_SECRET_KEY). Pubkey in GET /health as teleopGrantSignerPublicKey.
# After operator accepts help, robot polls GET /api/robots/{id}/teleop/session-grant?helpRequestId=
# TELEOP_GRANT_SIGNING_SECRET_KEY=
# TELEOP_GRANT_TTL_SEC=86400
# Flat SOL hint in grant scope_json for rospy_x402 /complete_teleop_payment (default 0.0005)
# TELEOP_OPERATOR_FLAT_SOL=0.0005

# Client API /api/client/* : command name any_teleop → POST {ANY_TELEOP_HTTP_PATH} on robot (ROS_X402_PAY), fixed estimate when method has no pricing
# ANY_TELEOP_HTTP_PATH=/x402/any_teleop
# ANY_TELEOP_FIXED_SOL=0.0005

# Peaq DID claim for teleop help (Agung dev). POST …/teleop/help may return peaq_claim; else GET …/peaq/claim?helpRequestId=. See docs/RAID_APP_PEAQ_CLAIM_SPEC.md
# With PEAQ_ENABLED=true and empty PEAQ_HTTP_BASE_URL / PEAQ_WSS_BASE_URL, Agung defaults apply (OnFinality + wss-async.agung.peaq.network) — see src/config.js.
# PEAQ_MACHINE_DID_NAME and PEAQ_MACHINE_EVM_ADDRESS — from machine after Agung onboard (else did.read returns no document).
PEAQ_ENABLED=true
# PEAQ_HTTP_BASE_URL=https://peaq-agung.api.onfinality.io/public
# PEAQ_WSS_BASE_URL=wss://wss-async.agung.peaq.network
PEAQ_MACHINE_DID_NAME=raid_machine_dev
PEAQ_MACHINE_EVM_ADDRESS=0x0000000000000000000000000000000000000000
PEAQ_NETWORK=peaq-agung
PEAQ_CLAIM_SYNC_TIMEOUT_MS=8000

# One-off machine DID onboard on Agung (npm run peaq:onboard). Do NOT commit keys to the repo.
# PEAQ_ONBOARD_EVM_PRIVATE_KEY=
# PEAQ_ONBOARD_MACHINE_NAME=raid_m_custom   # optional; else random raid_m_<hex>

# Request test AGNG via same faucet API as docs.peaq.xyz (npm run peaq:faucet) — bypasses browser CORS.
# PEAQ_FAUCET_ADDRESS=0x...
# PEAQ_FAUCET_APIKEY=   # if Peaq changes the docs widget key — copy from page source (APIKEY field)
# PEAQ_FAUCET_URL=https://dev-peaq-faucet-service.cisys.xyz/get-test-tokens
# PEAQ_FAUCET_TIMEOUT_MS=180000

# Admin panel: form login at /ui → JWT in httpOnly cookie admin_session (POST /api/admin/login).
# Same pair as HTTP Basic for /api/admin/*. Not the same as teleoperator login (PostgreSQL).
# Save .env as UTF-8 without BOM if the first variable seems ignored; use quotes if password contains #.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Sign admin_session JWT. In production set explicitly (or reuse TELEOPERATOR_JWT_SECRET).
# ADMIN_SESSION_SECRET=
# Session lifetime (default 8h), e.g. 24h, 3600s
# ADMIN_SESSION_EXPIRES_IN=8h
# Cookie Secure: auto (default), always, never — same idea as TELEOPERATOR_COOKIE_SECURE
# ADMIN_COOKIE_SECURE=auto

# AI Agent Configuration (for RAID mode executor selection)
AI_AGENT_STRATEGY=smart
# Options: smart, lowest_price, closest, fastest
# N8N Integration (optional)
N8N_WEBHOOK_URL=
# Example: https://your-n8n-instance.com/webhook/robot-selection

